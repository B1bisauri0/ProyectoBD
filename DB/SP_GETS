CREATE PROCEDURE get_Resenas
    @id_producto INT,     -- ID del producto
    @PageNumber INT,      -- Número de página
    @PageSize INT = 10,   -- Tamaño de página (por defecto 10)
    @OutCode INT OUTPUT   -- Código de salida
AS
BEGIN
    BEGIN TRY
        -- Validar que el producto existe
        IF NOT EXISTS (SELECT 1 FROM Productos WHERE ID_Producto = @id_producto)
        BEGIN
            SET @OutCode = 50016; -- Producto no encontrado
            RETURN;
        END

        -- Validar parámetros de paginación
        IF @PageNumber <= 0 OR @PageSize <= 0
        BEGIN
            SET @OutCode = 50017; -- Parámetros de paginación inválidos
            RETURN;
        END

        -- Calcular el número de registros a omitir
        DECLARE @Offset INT = (@PageNumber - 1) * @PageSize;

        -- Obtener las reseñas del producto con paginación
        SELECT 
            CONCAT(u.Nombre, ' ', u.Apellido) AS NombreUsuario,
            p.Nombre_Producto AS NombreProducto,
            r.Calificacion,
            r.Comentario,
            r.Fecha
        FROM 
            Reseñas r
        INNER JOIN 
            Usuarios u ON r.ID_Usuario = u.ID_Usuario
        INNER JOIN 
            Productos p ON r.ID_Producto = p.ID_Producto
        WHERE 
            r.ID_Producto = @id_producto
        ORDER BY 
            r.Fecha DESC -- Ordenar por fecha de reseña, más recientes primero
        OFFSET @Offset ROWS
        FETCH NEXT @PageSize ROWS ONLY;

        -- Si la ejecución fue exitosa
        SET @OutCode = 0; -- Operación exitosa

