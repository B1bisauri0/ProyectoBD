    BEGIN CATCH
        -- Manejar errores y establecer un código de error general
        SET @OutCode = 50000; -- Error general

        -- Capturar el mensaje del error
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
