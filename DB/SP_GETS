            m.Nombre_Marca,
            p.Precio,
            p.Existencias,
            p.Fecha_Creacion,
            p.URL_Imagen
        FROM 
            Productos p
        INNER JOIN 
            Categorías c ON p.ID_Categoria = c.ID_Categoria
        INNER JOIN 
            Marcas m ON p.ID_Marca = m.ID_Marca
        WHERE 
            c.Nombre_Categoria = @categoria
        ORDER BY 
            p.Nombre_Producto; -- Ordenar por nombre de producto

        -- Si la ejecución fue exitosa
        SET @OutCode = 0; -- Operación exitosa

    END TRY
    BEGIN CATCH
        -- Manejar errores y establecer un código de error general
