CREATE PROCEDURE get_TopCategorias
AS
BEGIN
    BEGIN TRY
        -- Seleccionar las 3 categorías más compradas basándose en el número total de productos vendidos
        SELECT TOP 3
            c.ID_Categoria,
            c.Nombre_Categoria,
            COUNT(pd.ID_Producto) AS Total_Productos_Vendidos,
            SUM(pd.Cantidad) AS Total_Unidades_Vendidas
        FROM 
            Pedido_Detalle pd
        INNER JOIN 
            Productos p ON pd.ID_Producto = p.ID_Producto
        INNER JOIN 
            Categorías c ON p.ID_Categoria = c.ID_Categoria
        GROUP BY 
            c.ID_Categoria, 
            c.Nombre_Categoria
        ORDER BY 
            Total_Unidades_Vendidas DESC, -- Ordenar por total de unidades vendidas
            Total_Productos_Vendidos DESC; -- Orden secundario por número de productos vendidos

    END TRY
    BEGIN CATCH
        -- Manejar errores
