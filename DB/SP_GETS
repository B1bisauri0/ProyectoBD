CREATE PROCEDURE get_descuentos
    @PageNumber INT,                   -- Número de la página
    @PageSize INT = 10,                -- Cantidad de registros por página (10 por defecto)
    @OutCode INT OUTPUT                -- Código de salida
AS
BEGIN
    BEGIN TRY
        -- Validar que los parámetros de paginación sean válidos
        IF @PageNumber <= 0 OR @PageSize <= 0
        BEGIN
            SET @OutCode = 50017; -- Parámetros de paginación inválidos
            RETURN;
        END

        -- Calcular el número de registros a omitir
        DECLARE @Offset INT = (@PageNumber - 1) * @PageSize;

        -- Seleccionar productos con descuento aplicando la función calcular_precio_unitario
        SELECT 
            p.Nombre_Producto AS NombreProducto,
            d.Descuento_Porcentaje AS DescuentoPorcentaje,
            d.Fecha_Inicio AS FechaInicio,
            d.Fecha_Fin AS FechaFin,
            p.Precio AS PrecioOriginal,
            dbo.calcular_precio_unitario(p.ID_Producto) AS PrecioConDescuento
        FROM 
            Descuentos d
        INNER JOIN 
            Productos p ON d.ID_Producto = p.ID_Producto
        WHERE 
            CAST(GETDATE() AS DATE) BETWEEN d.Fecha_Inicio AND ISNULL(d.Fecha_Fin, CAST(GETDATE() AS DATE))
        ORDER BY 
            d.Fecha_Inicio ASC, -- Ordenar por fecha de inicio del descuento
            p.Nombre_Producto ASC -- Orden secundario por nombre del producto
        OFFSET @Offset ROWS
        FETCH NEXT @PageSize ROWS ONLY;

        -- Si la ejecución fue exitosa
        SET @OutCode = 0; -- Código para operación exitosa

    END TRY
    BEGIN CATCH
        -- Manejar errores
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
        THROW 50000, @ErrorMessage, 1;
    END CATCH
END;
