CREATE PROCEDURE get_ventas_por_mes
    @year INT,           -- Año para filtrar las ventas
    @PageNumber INT,     -- Número de la página
    @PageSize INT = 10,  -- Tamaño de página (10 registros por defecto)
    @OutCode INT OUTPUT  -- Código de salida
AS
BEGIN
    BEGIN TRY
        -- Validar que los parámetros de paginación sean válidos
        IF @PageNumber <= 0 OR @PageSize <= 0
        BEGIN
            SET @OutCode = 50017; -- Parámetros de paginación inválidos
            RETURN;
        END

        -- Calcular el número de registros a omitir
        DECLARE @Offset INT = (@PageNumber - 1) * @PageSize;

        -- Seleccionar las ventas para cada mes del año especificado con paginación
        SELECT 
            DATENAME(MONTH, p.Fecha_Pedido) AS Mes,
            CONCAT(u.Nombre, ' ', u.Apellido) AS NombreUsuario,
            p.ID_Pedido AS IDPedido,
            pr.Nombre_Producto AS NombreProducto,
            c.Nombre_Categoria AS NombreCategoria,
            m.Nombre_Marca AS NombreMarca,
            pd.Cantidad AS Cantidad,
            pd.Precio_Unitario AS PrecioUnitario,
            CAST(pd.Cantidad * pd.Precio_Unitario AS DECIMAL(10, 2)) AS Total
        FROM 
            Pedido_Detalle pd
        INNER JOIN 
            Pedidos p ON pd.ID_Pedido = p.ID_Pedido
        INNER JOIN 
            Usuarios u ON p.ID_Usuario = u.ID_Usuario
        INNER JOIN 
            Productos pr ON pd.ID_Producto = pr.ID_Producto
        INNER JOIN 
            Categorías c ON pr.ID_Categoria = c.ID_Categoria
        INNER JOIN 
            Marcas m ON pr.ID_Marca = m.ID_Marca
        WHERE 
            YEAR(p.Fecha_Pedido) = @year -- Filtrar por el año especificado
        ORDER BY 
            DATENAME(MONTH, p.Fecha_Pedido), -- Ordenar por mes
            m.Nombre_Marca, -- Ordenar por marca
            p.ID_Pedido -- Ordenar adicionalmente por ID de pedido
        OFFSET @Offset ROWS
        FETCH NEXT @PageSize ROWS ONLY;

        -- Si la ejecución fue exitosa
        SET @OutCode = 0; -- Código para operación exitosa

    END TRY
    BEGIN CATCH
        -- Manejar errores y establecer un código de error general
        SET @OutCode = 50000; -- Error general

        -- Capturar el mensaje del error
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
        THROW 50000, @ErrorMessage, 1;
    END CATCH
END;
