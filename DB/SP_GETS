    -- util para modificar con upsert(pendiente, en preparación, enviado, entregado)
CREATE PROCEDURE get_userPedidos
    @Correo_Electronico NVARCHAR(150), -- Correo del usuario
    @PageNumber INT,                   -- Número de la página
    @PageSize INT = 10,                -- Cantidad de registros por página (10 por defecto)
    @OutCode INT OUTPUT                -- Código de salida
AS
BEGIN
    BEGIN TRY
        -- Validar que el número de página y el tamaño de página sean válidos
        IF @PageNumber <= 0 OR @PageSize <= 0
        BEGIN
            SET @OutCode = 50017; -- Parámetros de paginación inválidos
            RETURN;
        END

        -- Validar que el usuario exista
        IF NOT EXISTS (SELECT 1 FROM Usuarios WHERE Correo_Electronico = @Correo_Electronico)
        BEGIN
            SET @OutCode = 50004; -- Usuario no encontrado
            RETURN;
        END

        -- Obtener el ID del usuario
        DECLARE @Usuario_Id INT;
        SET @Usuario_Id = (SELECT ID_Usuario FROM Usuarios WHERE Correo_Electronico = @Correo_Electronico);

        -- Calcular el número de registros a omitir
        DECLARE @Offset INT = (@PageNumber - 1) * @PageSize;

        -- Seleccionar pedidos del usuario con paginación
        SELECT 
            p.ID_Pedido,
            p.Fecha_Pedido,
            p.Estado,
            p.Precio_Total,
            d.Direccion,
            mp.Tipo AS Metodo_Pago,
            mp.Detalles AS Detalles_Metodo_Pago
        FROM 
            Pedidos p
        INNER JOIN 
            Direcciones d ON p.ID_Direccion = d.ID_Direccion
        INNER JOIN 
            Métodos_Pago mp ON p.ID_Metodo_Pago = mp.ID_Metodo_Pago
        WHERE 
            p.ID_Usuario = @Usuario_Id
        ORDER BY 
            p.Fecha_Pedido DESC, -- Mostrar pedidos más recientes primero
            p.ID_Pedido DESC
        OFFSET @Offset ROWS
        FETCH NEXT @PageSize ROWS ONLY;

        -- Si la ejecución fue exitosa
        SET @OutCode = 0; -- Código para operación exitosa

    END TRY
    BEGIN CATCH
        -- Manejar errores
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
        THROW 50000, @ErrorMessage, 1;
    END CATCH
END;
GO




