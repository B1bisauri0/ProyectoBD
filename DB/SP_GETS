CREATE PROCEDURE get_ofertas_dia
    @PageNumber INT,  -- Número de la página
    @PageSize INT,     -- Cantidad de registros por página (puedes fijarlo a 10 si prefieres)
    @OutCode INT OUTPUT -- Código de salida para indicar el estado
AS
BEGIN
    BEGIN TRY
        -- Validar que los parámetros sean válidos
        IF @PageNumber <= 0 OR @PageSize <= 0
        BEGIN
            SET @OutCode = 50017;  -- Código para parámetros no válidos
            RETURN;
        END

        -- Calcular el número de registros a omitir
        DECLARE @Offset INT = (@PageNumber - 1) * @PageSize;

        -- Selección de productos con descuentos vigentes para el último día (hoy), con paginación
        SELECT 
            p.ID_Producto,
            p.Nombre_Producto,
            p.Descripcion,
            p.Precio AS Precio_Original,
            d.Descuento_Porcentaje,
            CAST(p.Precio * (1 - d.Descuento_Porcentaje / 100) AS DECIMAL(10, 2)) AS Precio_Con_Descuento,
            d.Fecha_Inicio,
            d.Fecha_Fin
        FROM 
            Productos p
        INNER JOIN 
            Descuentos d ON p.ID_Producto = d.ID_Producto
        WHERE 
            CAST(GETDATE() AS DATE) BETWEEN d.Fecha_Inicio AND d.Fecha_Fin -- Hoy es una fecha válida
            AND d.Fecha_Fin = CAST(GETDATE() AS DATE) -- Último día de vigencia
        ORDER BY 
            p.Nombre_Producto
        OFFSET @Offset ROWS
        FETCH NEXT @PageSize ROWS ONLY;

        -- Si la ejecución fue exitosa
        SET @OutCode = 0; -- Código para operación exitosa

    END TRY
    BEGIN CATCH
        -- Capturar errores y lanzarlos
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
        THROW 50000, @ErrorMessage, 1;
    END CATCH
END;
GO



