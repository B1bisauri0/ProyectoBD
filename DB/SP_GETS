CREATE PROCEDURE get_Destacados
AS
BEGIN
    BEGIN TRY
        -- Seleccionar los productos más vendidos (Top 5 por cantidad total)
        SELECT TOP 5
            p.ID_Producto,
            p.Nombre_Producto,
            p.Descripcion,
            c.Nombre_Categoria,
            m.Nombre_Marca,
            p.Precio,
            SUM(pd.Cantidad) AS Total_Vendido,
            COUNT(pd.ID_Pedido_Detalle) AS Total_Pedidos
        FROM 
            Pedido_Detalle pd
        INNER JOIN 
            Productos p ON pd.ID_Producto = p.ID_Producto
        INNER JOIN 
            Categorías c ON p.ID_Categoria = c.ID_Categoria
        INNER JOIN 
            Marcas m ON p.ID_Marca = m.ID_Marca
        GROUP BY 
            p.ID_Producto,
            p.Nombre_Producto,
            p.Descripcion,
            c.Nombre_Categoria,
            m.Nombre_Marca,
            p.Precio
        ORDER BY 
            Total_Vendido DESC, -- Ordenar por cantidad total vendida en orden descendente
            Total_Pedidos DESC; -- Si hay empate, ordenar por cantidad de pedidos

    END TRY
    BEGIN CATCH
        -- Manejar errores
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
        THROW 50000, @ErrorMessage, 1;
    END CATCH
END;
GO



    -----------------------------------------------------------------------------
	-------- Top 5 de clientes que más compran, suma monto de compras,   --------
    -------- cantidad de pedidos, cantidad de articulos distintos.       -------- 
	-----------------------------------------------------------------------------

CREATE PROCEDURE get_TopClientes
AS
BEGIN
    BEGIN TRY
        -- Seleccionar los 5 clientes principales basados en sus compras
        SELECT TOP 5
            u.ID_Usuario,
            CONCAT(u.Nombre, ' ', u.Apellido) AS NombreCompleto,
            COUNT(DISTINCT p.ID_Pedido) AS Total_Pedidos,
            SUM(pd.Precio_Unitario * pd.Cantidad) AS Monto_Total_Compras,
            COUNT(DISTINCT pd.ID_Producto) AS Total_Articulos_Distintos
        FROM 
            Usuarios u
        INNER JOIN 
            Pedidos p ON u.ID_Usuario = p.ID_Usuario
        INNER JOIN 
            Pedido_Detalle pd ON p.ID_Pedido = pd.ID_Pedido
        GROUP BY 
            u.ID_Usuario, 
            u.Nombre, 
            u.Apellido
        ORDER BY 
            Monto_Total_Compras DESC, -- Ordenar por monto total comprado
            Total_Pedidos DESC,       -- Ordenar secundario por número de pedidos
            Total_Articulos_Distintos DESC; -- Ordenar terciario por artículos distintos

    END TRY
    BEGIN CATCH
        -- Manejar errores
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
        THROW 50000, @ErrorMessage, 1;
    END CATCH
END;
GO



