CREATE PROCEDURE get_historial_pedidos
    @usuarioID INT,      -- ID del usuario
    @PageNumber INT,      -- Número de la página
    @PageSize INT = 10,   -- Tamaño de página (10 registros por defecto)
    @OutCode INT OUTPUT  -- Código de salida
AS
BEGIN
    BEGIN TRY
        -- Validar que el usuario existe
        IF NOT EXISTS (SELECT 1 FROM Usuarios WHERE ID_Usuario = @usuarioID)
        BEGIN
            SET @OutCode = 50004; -- Usuario no encontrado
            RETURN;
        END

        -- Validar que los parámetros de paginación sean válidos
        IF @PageNumber <= 0 OR @PageSize <= 0
        BEGIN
            SET @OutCode = 50017; -- Parámetros de paginación inválidos
            RETURN;
        END

        -- Calcular el número de registros a omitir
        DECLARE @Offset INT = (@PageNumber - 1) * @PageSize;

        -- Obtener el historial de pedidos del usuario con paginación
        SELECT 
            CONCAT(u.Nombre, ' ', u.Apellido) AS NombreUsuario,
            p.ID_Pedido AS PedidoID,
            p.Fecha_Pedido,
            p.Estado,
            p.Precio_Total AS PrecioTotal,
            CONCAT(d.Direccion, ', ', d.Ciudad, ', ', ISNULL(d.Provincia, ''), ', ', d.Pais) AS Direccion,
            CONCAT(mp.Tipo, ': ', mp.Detalles) AS DetallesMetodo
        FROM 
            Pedidos p
        INNER JOIN 
            Usuarios u ON p.ID_Usuario = u.ID_Usuario
        INNER JOIN 
            Direcciones d ON p.ID_Direccion = d.ID_Direccion
        INNER JOIN 
            Métodos_Pago mp ON p.ID_Metodo_Pago = mp.ID_Metodo_Pago
        WHERE 
            p.ID_Usuario = @usuarioID
        ORDER BY 
            p.Fecha_Pedido DESC -- Ordenar por fecha de pedido, de más reciente a más antiguo
        OFFSET @Offset ROWS
        FETCH NEXT @PageSize ROWS ONLY;

        -- Si la ejecución fue exitosa
        SET @OutCode = 0; -- Código para operación exitosa

    END TRY
    BEGIN CATCH
        -- Manejar errores y establecer un código de error general
        SET @OutCode = 50000; -- Error general

        -- Capturar el mensaje del error
        DECLARE @ErrorMessage NVARCHAR(4000) = ERROR_MESSAGE();
        THROW 50000, @ErrorMessage, 1;
    END CATCH
END;
GO



